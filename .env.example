# CodeYang 环境变量配置示例
# 复制此文件为 .env 并填入你的配置

# ====================================
# API 配置
# ====================================

# Anthropic API Key（必需）
# 获取: https://console.anthropic.com/
CODEYANG_API_KEY=your_anthropic_api_key_here

# API 基础 URL（可选，用于代理）
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ====================================
# 限流配置（防止中途停止）
# ====================================

# Bash 命令限流（默认: 200 次/分钟）
CODEYANG_BASH_LIMIT=500

# 网络请求限流（默认: 50 次/分钟）
CODEYANG_NETWORK_LIMIT=100

# 文件操作限流（默认: 100 次/分钟）
CODEYANG_FILE_LIMIT=200

# Git 操作限流（默认: 50 次/分钟）
CODEYANG_GIT_LIMIT=100

# MCP 调用限流（默认: 100 次/分钟）
CODEYANG_MCP_LIMIT=200

# ====================================
# 调试配置
# ====================================

# 启用调试日志（默认: false）
CODEYANG_DEBUG=false

# 日志级别（debug, info, warn, error）
# LOG_LEVEL=info

# ====================================
# 性能配置
# ====================================

# Node.js 内存限制（MB，默认: 自动）
NODE_OPTIONS=--max-old-space-size=4096

# Bash 命令超时（秒，默认: 60）
# CODEYANG_BASH_TIMEOUT=120

# ====================================
# 数据目录
# ====================================

# CodeYang 数据目录（默认: ~/.codeyang）
# CODEYANG_HOME=/custom/path/to/.codeyang

# ====================================
# 高级配置
# ====================================

# 禁用限流（仅用于测试，不推荐）
# CODEYANG_DISABLE_RATE_LIMIT=true

# 禁用沙箱（不推荐，安全风险）
# CODEYANG_DISABLE_SANDBOX=false

# 禁用权限检查（不推荐，安全风险）
# CODEYANG_DISABLE_PERMISSION=false

# ====================================
# 开发配置
# ====================================

# 开发模式（启用热重载）
# NODE_ENV=development

# 测试模式
# NODE_ENV=test

# ====================================
# 使用说明
# ====================================
#
# 1. 复制此文件: cp .env.example .env
# 2. 填入你的 API Key
# 3. 根据需要调整其他配置
# 4. 启动: npm start
#
# 注意:
# - .env 文件已在 .gitignore 中，不会被提交
# - 不要将包含真实 API Key 的 .env 文件提交到 Git
# - 生产环境建议使用系统环境变量而非 .env 文件
