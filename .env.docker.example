# Docker 环境变量配置
# 复制此文件为 .env 并填入你的配置

# === 必需配置 ===

# LLM 提供商 (deepseek|openai|anthropic)
CODEYANG_PROVIDER=deepseek

# API Key (必需)
CODEYANG_API_KEY=your-api-key-here

# === 可选配置 ===

# 模型名称
# DeepSeek: deepseek-reasoner, deepseek-chat
# OpenAI: gpt-4, gpt-3.5-turbo
# Anthropic: claude-sonnet-4-20250514, claude-3-5-sonnet-20241022
CODEYANG_MODEL=deepseek-reasoner

# 最大 Token 数
CODEYANG_MAX_TOKENS=8192

# 温度参数 (0.0 - 1.0)
CODEYANG_TEMPERATURE=0.7

# 自定义 Base URL (如果使用代理)
# CODEYANG_BASE_URL=https://your-proxy.com

# 调试模式
CODEYANG_DEBUG=false

# === 资源限制 (在 docker-compose.yml 中配置) ===
# CPU: 1-2 核
# 内存: 2-4 GB
