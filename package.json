{
    "name": "codeyang",
    "version": "1.1.2",
    "description": "Terminal-based AI coding agent with 80+ core tools, MCP integration, multi-provider LLM support, and session persistence",
    "type": "module",
    "main": "./dist/lib.js",
    "types": "./dist/lib.d.ts",
    "bin": {
        "codeyang": "./dist/index.js",
        "codeyangx": "./dist/codeyangx.js",
        "codeyang-web": "./dist/web-server.js",
        "codeyang-setup": "./dist/setup-wizard.js"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "docs/STATUS.md",
        "docs/QUICKSTART.md",
        "docs/architecture.md",
        "docs/api-reference.md",
        "docs/SECURITY.md",
        "docs/CHANGELOG.md"
    ],
    "engines": {
        "node": ">=18"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/davidjlyoung1985-byte/codeyang.git"
    },
    "homepage": "https://github.com/davidjlyoung1985-byte/codeyang#readme",
    "bugs": {
        "url": "https://github.com/davidjlyoung1985-byte/codeyang/issues"
    },
    "scripts": {
        "build": "tsup --config tsup.config.ts && node scripts/build-extension-tools.mjs",
        "dev": "tsup src/index.ts --format esm --clean --sourcemap --watch --outDir dist",
        "start": "node dist/index.js",
        "setup": "tsx src/setup-wizard.ts",
        "web:server": "tsx web/server/index.ts",
        "web:client": "vite",
        "web:build": "vite build",
        "web:dev": "concurrently \"npm run web:server\" \"npm run web:client\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "bench": "vitest bench --reporter=verbose",
        "prepublishOnly": "npm run build",
        "lint": "eslint src/ --ext .ts",
        "lint:fix": "eslint src/ --ext .ts --fix",
        "format": "prettier --write \"src/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\"",
        "generate-docs": "npx tsx src/tools/auto-docs.ts",
        "check": "npx tsc --noEmit",
        "audit": "npm audit --audit-level=high",
        "prepare": "husky",
        "build:extension-tools": "node scripts/build-extension-tools.mjs",
        "test:unit": "vitest run --config vitest.unit.config.ts",
        "test:slow": "vitest run src/tools/GitTool.test.ts src/tools/BashTool.test.ts src/tools/PowerShellTool.test.ts src/agent/Agent.test.ts src/sandbox/sandbox-integration.test.ts src/sandbox/sandbox-runner.test.ts src/sandbox/os-isolation.test.ts src/sandbox/os-isolation.coverage.test.ts src/sandbox/os-isolation-windows.test.ts src/mcp/McpClient.test.ts src/mcp/McpManager.test.ts src/tools/mcp.test.ts src/e2e/e2e.test.ts",
        "mutation": "stryker run",
        "mutation:fast": "stryker run --mutate src/security/ssrf.ts --thresholds.break 0"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.32.0",
        "@babel/parser": "^7.29.7",
        "@babel/traverse": "^7.29.7",
        "@modelcontextprotocol/sdk": "^1.29.0",
        "acorn": "^8.16.0",
        "acorn-walk": "^8.3.5",
        "axios": "^1.17.0",
        "better-sqlite3": "^13.2.0",
        "csv-parse": "^7.0.2",
        "csv-stringify": "^6.7.0",
        "dotenv": "^17.4.2",
        "execa": "^9.3.0",
        "fast-xml-parser": "^5.8.0",
        "form-data": "^4.0.5",
        "mathjs": "^15.2.0",
        "minimatch": "^10.2.5",
        "openai": "^6.42.0",
        "picocolors": "^1.1.0",
        "ws": "^8.23.0",
        "yaml": "^2.9.0"
    },
    "overrides": {
        "esbuild": "^0.28.1"
    },
    "lint-staged": {
        "*.ts": [
            "prettier --check",
            "eslint --fix"
        ]
    },
    "devDependencies": {
        "@types/babel__traverse": "^7.28.0",
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^25.9.1",
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@types/ws": "^8.18.2",
        "@typescript-eslint/eslint-plugin": "^8.60.0",
        "@typescript-eslint/parser": "^8.60.1",
        "@vitejs/plugin-react": "^6.0.4",
        "@vitest/coverage-v8": "^3.2.6",
        "concurrently": "^9.1.2",
        "esbuild": "^0.28.1",
        "eslint": "^10.4.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.7",
        "prettier": "^3.8.3",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tsup": "^8.5.1",
        "tsx": "^4.19.2",
        "typescript": "^5.5.0",
        "typescript-eslint": "^8.60.0",
        "vite": "^8.1.5",
        "vitest": "^3.2.6"
    },
    "exports": {
        ".": {
            "types": "./dist/lib.d.ts",
            "import": "./dist/lib.js"
        },
        "./security": {
            "types": "./dist/lib.d.ts",
            "import": "./dist/lib.js"
        },
        "./package.json": "./package.json"
    }
}
